# Copy to .env.local (ignored by git). EXPO_PUBLIC_* values are inlined in the app bundle: no secrets here.

# API of the website. Use your Vercel preview URL or a tunnel for local testing.
EXPO_PUBLIC_API_URL=https://nutrikafood.com/api/v1

# Google Cloud OAuth clients (APIs & Services > Credentials), same project as the website's Google login.
# Web client ID: the audience of the ID token. Must also be listed in GOOGLE_CLIENT_IDS on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID (bundle ID com.nutrikafood.app). Also add it to GOOGLE_CLIENT_IDS on the server.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
